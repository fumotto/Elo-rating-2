{
  "name": "elo-rating-2",
  "private": true,
  "version": "1.0.0",
  "description": "3v3 team match Elo rating manager with Supabase backend",
  "scripts": {
    "dev": "npm run dev",
    "build": "npm run build",
    "test": "cd ./vite && npm run test",
    "lint": "cd ./vite && npm run lint",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "editorconfig":"editorconfig ./",
    "render:docs": "node scripts/generate-api-docs.mjs",
    "render:diagrams": "node scripts/render-diagrams.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "editorconfig": "^3.0.2",
    "mmdc": "^0.0.1",
    "supabase": "^2.108.0",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.15.0"
  }
}
